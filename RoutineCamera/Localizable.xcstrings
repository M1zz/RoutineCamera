          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Vain kirjaus” -ryhmiä ei voi vielä luoda. Luo toistaiseksi ”Koko ateria” -ryhmä, kunnes iCloud-päivitys on otettu käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes « Enregistré ou non » ne sont pas encore disponibles. En attendant la mise à jour iCloud, créez un groupe « Repas complets »."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup “Dicatat atau Tidak” belum tersedia. Sampai pembaruan iCloud diluncurkan, buat grup “Lengkap”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I gruppi “Solo se registrato” non sono ancora disponibili. Finché non arriva l’aggiornamento di iCloud, crea un gruppo “Pasti completi”."
