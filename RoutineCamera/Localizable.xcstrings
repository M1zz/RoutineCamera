    "기본 스탬프에 없는 음식이나 습관을 이모지와 이름으로 만들어 찍어요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add foods or habits that aren't in the built-in stamps, with your own emoji and name."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add foods or habits that aren't in the built-in stamps, with your own emoji and name."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vytvoř si razítko s vlastním emoji a názvem pro jídlo nebo zvyk, který v nabídce chybí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav stempler med din egen emoji og dit eget navn til mad eller vaner, der ikke er med fra start."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstelle Stempel mit eigenem Emoji und Namen für Essen oder Gewohnheiten, die noch fehlen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε σφραγίδες με δικό σου emoji και όνομα για φαγητά ή συνήθειες που δεν υπάρχουν ήδη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea sellos con tu propio emoji y nombre para comidas o hábitos que no vienen incluidos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tee omalla emojilla ja nimellä leimoja ruoille tai tavoille, joita valmiista leimoista ei löydy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez des tampons avec l'emoji et le nom de votre choix pour les aliments ou habitudes absents de la liste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat stempel dengan emoji dan nama sendiri untuk makanan atau kebiasaan yang belum ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea timbri con emoji e nome a tua scelta per cibi o abitudini che non trovi già pronti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本のスタンプにない食べ物や習慣を、絵文字と名前で作って押せます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lag stempler med egen emoji og eget navn for mat eller vaner som ikke finnes fra før."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak stempels met je eigen emoji en naam voor eten of gewoonten die er nog niet tussen staan."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twórz pieczątki z własnym emoji i nazwą dla potraw lub nawyków, których brakuje na liście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
