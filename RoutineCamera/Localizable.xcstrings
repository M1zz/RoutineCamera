    "켜면 내 식단이 iCloud에 업로드되어 친구가 볼 수 있습니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zapnutí se tvá jídla nahrají do iCloudu a uvidí je tví přátelé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når det er slået til, uploades dine måltider til iCloud, så dine venner kan se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden deine Mahlzeiten in iCloud hochgeladen, damit deine Freunde sie sehen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι ενεργό, τα γεύματά σου ανεβαίνουν στο iCloud ώστε να τα βλέπουν οι φίλοι σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your meals are uploaded to iCloud so your friends can see them."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When on, your meals are uploaded to iCloud so your friends can see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo activas, tus comidas se suben a iCloud para que tus amigos puedan verlas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun tämä on päällä, ateriasi ladataan iCloudiin, jotta kaverit näkevät ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si activé, vos repas sont envoyés dans iCloud pour que vos amis puissent les voir."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika aktif, makananmu diunggah ke iCloud agar teman bisa melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se attivo, i tuoi pasti vengono caricati su iCloud così i tuoi amici possono vederli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、あなたの食事がiCloudにアップロードされ、フレンドが見られるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜면 내 식단이 iCloud에 업로드되어 친구가 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når dette er på, lastes måltidene dine opp til iCloud så vennene dine kan se dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als dit aan staat, worden je maaltijden geüpload naar iCloud zodat je vrienden ze kunnen zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu Twoje posiłki są wysyłane do iCloud, aby znajomi mogli je zobaczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, suas refeições são enviadas ao iCloud para os amigos verem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включить, ваше питание загружается в iCloud, и друзья смогут его видеть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När det är på laddas dina måltider upp till iCloud så att dina vänner kan se dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิด มื้ออาหารของคุณจะถูกอัปโหลดขึ้น iCloud เพื่อให้เพื่อนดูได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkken öğünlerin iCloud'a yüklenir ve arkadaşların görebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, bữa ăn của bạn được tải lên iCloud để bạn bè xem được."
          }
        },
        "zh-Hans" : {
