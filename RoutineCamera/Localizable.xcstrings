          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้เลือกมื้อ จึงไม่มีการแจ้งเตือน บันทึกเมื่อไรก็ได้ตามสะดวก"
