    "고른 식사만 리마인드 알림을 받아요." : {
      "comment" : "A description of the meal care section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připomínky dostaneš jen k vybraným jídlům."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får kun påmindelser om de måltider, du vælger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst nur für die Mahlzeiten Erinnerungen, die du auswählst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα λαμβάνεις υπενθυμίσεις μόνο για τα γεύματα που επιλέγεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll only get reminders for the meals you pick."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’ll only get reminders for the meals you pick."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo recibirás recordatorios de las comidas que elijas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat muistutuksia vain valitsemistasi aterioista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne recevez des rappels que pour les repas choisis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu hanya akan mendapat pengingat untuk waktu makan yang kamu pilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi promemoria solo per i pasti che scegli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ食事のリマインド通知だけが届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 식사만 리마인드 알림을 받아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får bare påminnelser om måltidene du velger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je krijgt alleen herinneringen voor de maaltijden die je kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przypomnienia dostaniesz tylko o wybranych posiłkach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você só recebe lembretes das refeições que escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания приходят только для выбранных приёмов пищи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får bara påminnelser för de måltider du väljer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้รับการเตือนเฉพาะมื้อที่เลือกไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca seçtiğin öğünler için hatırlatma alırsın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn chỉ nhận nhắc nhở cho những bữa đã chọn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只会收到你所选餐次的提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會收到你所選餐點的提醒。"
          }
        }
      }
    },
    "고른 식사만 살짝 알려드릴게요.\n나머지는 부담 없이, 기록하고 싶을 때만." : {
      "comment" : "A description of the benefits of using the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorníme tě jen na vybraná jídla.\nZbytek zapisuj, kdy chceš, bez tlaku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi giver dig et blidt skub til de måltider, du vælger.\nResten registrerer du, når det passer dig – uden pres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erinnern dich sanft an die Mahlzeiten, die du auswählst.\nAlles andere ohne Druck – trag nur ein, wenn du magst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σε ειδοποιούμε διακριτικά για τα γεύματα που επιλέγεις.\nΤα υπόλοιπα τα καταγράφεις όποτε θες, χωρίς πίεση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll send a gentle nudge for the meals you pick.\nLog the rest whenever you like, no pressure."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll send a gentle nudge for the meals you pick.\nLog the rest whenever you like, no pressure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te daremos un aviso suave de las comidas que elijas.\nLo demás, sin presión: registra cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutamme lempeästi valitsemistasi aterioista.\nMuut voit kirjata milloin haluat, ilman painetta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit rappel discret, uniquement pour les repas que vous choisissez.\nLe reste, enregistrez-le quand vous voulez, sans pression."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan mengingatkanmu dengan lembut untuk waktu makan yang kamu pilih.\nSisanya catat kapan pun kamu mau, tanpa tekanan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avviseremo con delicatezza solo per i pasti che scegli.\nTutto il resto, senza pressioni: registri solo quando ne hai voglia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ食事だけ、そっとお知らせします。\n残りは気にせず、記録したいときだけで大丈夫です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 식사만 살짝 알려드릴게요.\n나머지는 부담 없이, 기록하고 싶을 때만."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi gir deg et vennlig puff for måltidene du velger.\nResten logger du når du har lyst, helt uten press."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sturen alleen voor de maaltijden die je kiest een vriendelijk seintje.\nHet overige leg je vast wanneer je wilt, zonder druk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatnie przypomnimy o wybranych posiłkach.\nResztę zapiszesz, kiedy zechcesz, bez presji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos avisar com delicadeza só das refeições que você escolher.\nO resto fica à vontade: registre quando quiser, sem pressão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы мягко напомним только о выбранных приёмах пищи.\nОстальное без давления: записывайте, когда захочется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ger en vänlig knuff för de måltider du väljer.\nLogga resten när du vill, utan krav."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะเตือนเบา ๆ เฉพาะมื้อที่คุณเลือก\nมื้อที่เหลือบันทึกตอนไหนก็ได้ ไม่ต้องกดดัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiğin öğünler için nazikçe hatırlatırız.\nGerisini istediğinde, baskı hissetmeden kaydedersin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki chỉ nhắc nhẹ những bữa bạn chọn.\nCác bữa còn lại cứ ghi khi nào bạn muốn, không áp lực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只对你选的餐次轻轻提醒一下。\n其余的不用有压力，想记再记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會輕輕提醒你選的餐點。\n其他的不用有壓力，想記錄時再記就好。"
          }
        }
      }
    },
