            "value" : "“Del mine måltider” er slået fra i Indstillinger, så der kan ikke uploades noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Meine Mahlzeiten teilen“ ist in den Einstellungen deaktiviert, daher kann nichts hochgeladen werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η «Κοινοποίηση των γευμάτων μου» είναι απενεργοποιημένη στις Ρυθμίσεις, οπότε δεν γίνεται ανέβασμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Share My Meals” is off in Settings, so nothing can be uploaded."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Share My Meals” is off in Settings, so nothing can be uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Compartir mis comidas” está desactivado en Ajustes, así que no se puede subir nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Jaa ateriani” on pois päältä Asetuksissa, joten mitään ei voi ladata."
          }
        },
        "fr" : {
          "stringUnit" : {
