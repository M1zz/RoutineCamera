    "함께 먹는 사람이 많아질수록 더 편해져요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more people you share meals with, the handier it gets."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "함께 먹는 사람이 많아질수록 더 편해져요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The more people you share meals with, the handier it gets."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makin banyak orang yang makan bersamamu, makin berguna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒に食べる人が増えるほど、もっと便利になります。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยิ่งมีคนกินด้วยกันมาก ก็ยิ่งสะดวก"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanto mais gente come junto com você, mais prático fica."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起吃饭的人越多，用起来越方便。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più sono le persone con cui condividi i pasti, più diventa comodo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoe meer mensen met wie je maaltijden deelt, hoe handiger het wordt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一起吃飯的人越多，就越方便。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo flere du deler måltider med, jo nyttigere blir det."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im więcej osób, z którymi jadasz, tym wygodniej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ju fler du delar måltider med, desto smidigare blir det."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чем больше людей, с которыми вы делитесь едой, тем удобнее."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo flere, du deler måltider med, jo mere praktisk bliver det."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuanta más gente comparta comidas contigo, más útil se vuelve."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όσο περισσότερα άτομα μοιράζεσαι γεύματα, τόσο πιο βολικό γίνεται."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mehr Leute mit dir essen und teilen, desto praktischer wird es."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Càng có nhiều người cùng ăn, bạn càng thấy tiện."
