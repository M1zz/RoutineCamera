    "Siri에게 앱 이름 없이 말해도 지난 식사 기록을 찾아 바로 열어 줘요." : {
      "comment" : "Roadmap item detail: ask Siri without saying the app name",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I když Siri neřeknete název aplikace, najde vaše dřívější jídlo a hned ho otevře."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv uden at nævne appens navn finder Siri et tidligere måltid og åbner det med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ohne den App-Namen findet Siri eine frühere Mahlzeit und öffnet sie sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμα κι αν δεν πείτε το όνομα της εφαρμογής, η Siri βρίσκει ένα παλιότερο γεύμα και το ανοίγει αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even without saying the app name, Siri finds a past meal and opens it right away."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even without saying the app name, Siri finds a past meal and opens it right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque no digas el nombre de la app, Siri encuentra una comida anterior y la abre al momento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka et sanoisi apin nimeä, Siri löytää aiemman aterian ja avaa sen heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même sans dire le nom de l’app, Siri retrouve un repas passé et l’ouvre aussitôt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa menyebut nama app pun, Siri menemukan catatan makan sebelumnya dan langsung membukanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche senza dire il nome dell’app, Siri trova un pasto passato e lo apre subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリ名を言わなくても、Siriが過去の食事の記録を見つけてすぐに開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siri에게 앱 이름 없이 말해도 지난 식사 기록을 찾아 바로 열어 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv uten å si appnavnet finner Siri et tidligere måltid og åpner det med en gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook zonder de appnaam te noemen vindt Siri een eerdere maaltijd en opent die meteen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet bez nazwy aplikacji Siri znajdzie wcześniejszy posiłek i od razu go otworzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo sem dizer o nome do app, a Siri encontra uma refeição anterior e abre na hora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже без названия приложения Siri найдёт прошлый приём пищи и сразу его откроет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även utan att du säger appens namn hittar Siri en tidigare måltid och öppnar den direkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม้ไม่เอ่ยชื่อแอป Siri ก็หามื้อที่เคยบันทึกไว้เจอและเปิดให้ทันที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın adını söylemesen de Siri geçmiş bir öğünü bulur ve hemen açar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dù không nói tên ứng dụng, Siri vẫn tìm thấy bữa ăn đã ghi và mở ngay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使不说应用名称，Siri 也能找到以前的用餐记录并立即打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使不說 App 名稱，Siri 也能找到以前的用餐紀錄並立即打開。"
          }
        }
      }
    },
