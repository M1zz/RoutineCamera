    "Face ID나 Touch ID로 앱을 잠가 내 식단 기록을 지켜요." : {
      "comment" : "Roadmap item detail: Face ID lock",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamkněte aplikaci přes Face ID nebo Touch ID a chraňte svůj jídelníček."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås appen med Face ID eller Touch ID, så din maddagbog forbliver privat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sperre die App mit Face ID oder Touch ID und schütze dein Ernährungstagebuch."
