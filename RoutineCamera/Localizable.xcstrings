    "이 그룹은 기록 여부만 공유합니다. 사진과 메모는 서로 보이지 않아요." : {
      "comment" : "A description of a group that only shows whether members have completed their tasks.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group only shares whether meals were logged. Photos and notes stay private."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹은 기록 여부만 공유합니다. 사진과 메모는 서로 보이지 않아요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group only shares whether meals were logged. Photos and notes stay private."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grup ini hanya membagikan apakah makan sudah dicatat. Foto dan catatan tetap pribadi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループでは、記録の有無だけが共有されます。写真とメモは互いに見えません。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กลุ่มนี้แชร์แค่ว่าบันทึกมื้ออาหารหรือไม่ รูปและโน้ตจะไม่แสดงให้ใครเห็น"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo só compartilha se as refeições foram registradas. Fotos e anotações ficam privadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个群组只共享是否已记录，照片和备注互不可见。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gruppo condivide solo se i pasti sono stati registrati. Foto e note restano private."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze groep deelt alleen of maaltijden zijn vastgelegd. Foto’s en notities blijven privé."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個群組只分享有沒有記錄，照片和備註不會公開。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne gruppen deler bare om måltider er logget. Bilder og notater forblir private."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta grupa pokazuje tylko, czy posiłki zostały zapisane. Zdjęcia i notatki pozostają prywatne."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här gruppen delar bara om måltider loggats. Foton och anteckningar förblir privata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта группа показывает только факт записи. Фото и заметки остаются скрытыми."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne gruppe deler kun, om måltider er registreret. Fotos og noter forbliver private."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo solo comparte si se registraron comidas. Las fotos y las notas siguen siendo privadas."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτή η ομάδα μοιράζεται μόνο το αν καταγράφηκαν γεύματα. Οι φωτογραφίες και οι σημειώσεις παραμένουν ιδιωτικές."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe teilt nur, ob Mahlzeiten eingetragen wurden. Fotos und Notizen bleiben privat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhóm này chỉ chia sẻ việc đã ghi bữa nào hay chưa. Ảnh và ghi chú được giữ riêng tư."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce groupe partage seulement si les repas ont été enregistrés. Les photos et les notes restent privées."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä ryhmä jakaa vain tiedon siitä, onko ateriat kirjattu. Kuvat ja muistiinpanot pysyvät yksityisinä."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tato skupina sdílí jen to, zda bylo jídlo zapsáno. Fotky a poznámky zůstávají soukromé."
          }
        }
      }
    },
