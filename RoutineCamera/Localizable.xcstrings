    "고른 식사만 살짝 알려드릴게요.\n나머지는 부담 없이, 기록하고 싶을 때만." : {
      "comment" : "A description of the benefits of using the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll send a gentle nudge for the meals you pick.\nLog the rest whenever you like, no pressure."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 식사만 살짝 알려드릴게요.\n나머지는 부담 없이, 기록하고 싶을 때만."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll send a gentle nudge for the meals you pick.\nLog the rest whenever you like, no pressure."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami akan mengingatkanmu dengan lembut untuk waktu makan yang kamu pilih.\nSisanya catat kapan pun kamu mau, tanpa tekanan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ食事だけ、そっとお知らせします。\n残りは気にせず、記録したいときだけで大丈夫です。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะเตือนเบา ๆ เฉพาะมื้อที่คุณเลือก\nมื้อที่เหลือบันทึกตอนไหนก็ได้ ไม่ต้องกดดัน"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos avisar com delicadeza só das refeições que você escolher.\nO resto fica à vontade: registre quando quiser, sem pressão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只对你选的餐次轻轻提醒一下。\n其余的不用有压力，想记再记。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avviseremo con delicatezza solo per i pasti che scegli.\nTutto il resto, senza pressioni: registri solo quando ne hai voglia."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We sturen alleen voor de maaltijden die je kiest een vriendelijk seintje.\nHet overige leg je vast wanneer je wilt, zonder druk."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只會輕輕提醒你選的餐點。\n其他的不用有壓力，想記錄時再記就好。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi gir deg et vennlig puff for måltidene du velger.\nResten logger du når du har lyst, helt uten press."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delikatnie przypomnimy o wybranych posiłkach.\nResztę zapiszesz, kiedy zechcesz, bez presji."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi ger en vänlig knuff för de måltider du väljer.\nLogga resten när du vill, utan krav."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы мягко напомним только о выбранных приёмах пищи.\nОстальное без давления: записывайте, когда захочется."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi giver dig et blidt skub til de måltider, du vælger.\nResten registrerer du, når det passer dig – uden pres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te daremos un aviso suave de las comidas que elijas.\nLo demás, sin presión: registra cuando quieras."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα σε ειδοποιούμε διακριτικά για τα γεύματα που επιλέγεις.\nΤα υπόλοιπα τα καταγράφεις όποτε θες, χωρίς πίεση."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir erinnern dich sanft an die Mahlzeiten, die du auswählst.\nAlles andere ohne Druck – trag nur ein, wenn du magst."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki chỉ nhắc nhẹ những bữa bạn chọn.\nCác bữa còn lại cứ ghi khi nào bạn muốn, không áp lực."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit rappel discret, uniquement pour les repas que vous choisissez.\nLe reste, enregistrez-le quand vous voulez, sans pression."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistutamme lempeästi valitsemistasi aterioista.\nMuut voit kirjata milloin haluat, ilman painetta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upozorníme tě jen na vybraná jídla.\nZbytek zapisuj, kdy chceš, bez tlaku."
          }
        }
      }
    },
