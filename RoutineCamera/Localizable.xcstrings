    "식단 사진을 기록합니다. 켜면 운동 기록으로 전환돼요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You’re logging meal photos. Turn this on to switch to workouts."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식단 사진을 기록합니다. 켜면 운동 기록으로 전환돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
