    "위치 권한이 꺼져 있어 찍은 곳을 남기지 못해요." : {
      "comment" : "Shown when location permission is denied",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přístup k poloze je vypnutý, místo nelze uložit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til lokalitet er slået fra, så stedet kan ikke gemmes."
