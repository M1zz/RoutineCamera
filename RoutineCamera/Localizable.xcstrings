    "대비를 높이거나 색을 구별하기 어려워도 기록한 끼니를 알아볼 수 있어요." : {
      "comment" : "Roadmap item detail: better colors and contrast",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I se zvýšeným kontrastem nebo když hůř rozlišujete barvy, poznáte zapsaná jídla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med øget kontrast, eller hvis farver er svære at skelne, kan du se de måltider, du har gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch mit erhöhtem Kontrast oder wenn Farben schwer zu unterscheiden sind, erkennst du deine erfassten Mahlzeiten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη και με αυξημένη αντίθεση ή αν δυσκολεύεσαι να ξεχωρίσεις χρώματα, αναγνωρίζεις τα γεύματα που κατέγραψες."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With higher contrast on, or if colors are hard to tell apart, you can still spot the meals you logged."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With higher contrast on, or if colours are hard to tell apart, you can still spot the meals you logged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque uses más contraste o te cueste distinguir colores, verás qué comidas registraste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka kontrasti olisi suurempi tai värejä olisi vaikea erottaa, tunnistat kirjaamasi ateriat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec un contraste renforcé ou si les couleurs sont difficiles à distinguer, vous repérez vos repas enregistrés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski kontras dinaikkan atau warna sulit dibedakan, kamu tetap bisa mengenali makan yang sudah dicatat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con il contrasto aumentato o se distingui a fatica i colori, riconosci i pasti registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントラストを上げていても、色を見分けにくくても、記録した食事がわかります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대비를 높이거나 색을 구별하기 어려워도 기록한 끼니를 알아볼 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med økt kontrast, eller om farger er vanskelige å skille, ser du hvilke måltider du har lagret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook met meer contrast of als je kleuren moeilijk onderscheidt, herken je je vastgelegde maaltijden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet przy zwiększonym kontraście lub trudnościach z rozróżnianiem kolorów rozpoznasz zapisane posiłki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com mais contraste ou com dificuldade para distinguir cores, você reconhece as refeições registradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже при повышенном контрасте или если трудно различать цвета, записанные приёмы пищи легко узнать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Även med ökad kontrast, eller om färger är svåra att skilja åt, ser du vilka måltider du har sparat."
          }
        },
        "th" : {
