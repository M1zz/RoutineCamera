    "%lld일 올림 · %lld일 건너뜀 · %lld일 실패. 다시 실행하면 실패한 날만 재시도합니다." : {
      "comment" : "Backfill summary: some days failed; uploaded, skipped, failed",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days uploaded: %1$lld · skipped: %2$lld · failed: %3$lld. Run it again to retry just the failed days."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld일 올림 · %lld일 건너뜀 · %lld일 실패. 다시 실행하면 실패한 날만 재시도합니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Days uploaded: %1$lld · skipped: %2$lld · failed: %3$lld. Run it again to retry just the failed days."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari terunggah: %1$lld · dilewati: %2$lld · gagal: %3$lld. Jalankan lagi untuk mencoba ulang hari yang gagal saja."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld日分をアップロード · %2$lld日分をスキップ · %3$lld日分が失敗しました。もう一度実行すると、失敗した日だけ再試行します。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัปโหลด %1$lld วัน · ข้าม %2$lld วัน · ไม่สำเร็จ %3$lld วัน ลองเรียกใช้อีกครั้งเพื่อทำเฉพาะวันที่ไม่สำเร็จ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias enviados: %1$lld · ignorados: %2$lld · com falha: %3$lld. Execute de novo para tentar só os dias que falharam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已上传%1$lld天 · 已跳过%2$lld天 · 失败%3$lld天。再次运行将只重试失败的天数。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giorni caricati: %1$lld · saltati: %2$lld · non riusciti: %3$lld. Riavvia per riprovare solo con i giorni non riusciti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagen geüpload: %1$lld · overgeslagen: %2$lld · mislukt: %3$lld. Voer het opnieuw uit om alleen de mislukte dagen opnieuw te proberen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
