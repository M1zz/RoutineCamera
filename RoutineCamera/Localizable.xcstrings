    "가족, 회사, 운동 모임처럼 함께 먹는 사람마다 그룹을 따로 둘 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro každou partu, se kterou jíš, můžeš mít zvláštní skupinu: rodinu, kolegy nebo cvičební partu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en separat gruppe til hver kreds, du spiser med, fx familie, kolleger eller træningsholdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege für jede Runde, mit der du isst, eine eigene Gruppe an, zum Beispiel für Familie, Arbeit oder deine Trainingsgruppe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε ξεχωριστή ομάδα για κάθε παρέα που τρως μαζί, όπως οικογένεια, συνάδελφοι ή η ομάδα της προπόνησης."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a separate group for each circle you eat with, like family, coworkers, or your workout crew."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep a separate group for each circle you eat with, like family, colleagues, or your workout crew."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un grupo aparte para cada círculo con el que comes: familia, trabajo o tu grupo de ejercicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit tehdä jokaiselle ruokaseuralle oman ryhmän, kuten perheelle, työkavereille tai treeniporukalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un groupe distinct pour chaque cercle avec qui vous mangez : famille, collègues, équipe de sport."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat grup terpisah untuk setiap lingkaran makanmu, seperti keluarga, rekan kerja, atau teman olahraga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un gruppo diverso per ogni cerchia con cui mangi: famiglia, colleghi o compagni di allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族、職場、運動仲間など、一緒に食べる人ごとにグループを分けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족, 회사, 운동 모임처럼 함께 먹는 사람마다 그룹을 따로 둘 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha en egen gruppe for hver krets du spiser sammen med, som familie, kolleger eller treningsgjengen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak voor elke kring waarmee je eet een aparte groep, zoals familie, collega’s of je sportmaatjes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla każdego grona, z którym jadasz, możesz założyć osobną grupę: rodziny, współpracowników czy ekipy treningowej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um grupo para cada turma com quem você come, como família, colegas de trabalho ou o pessoal do treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заведите отдельную группу для каждой компании, с которой вы едите: семьи, коллег или друзей по тренировкам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha en egen grupp för varje sällskap du äter med, som familjen, jobbet eller träningskompisarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แยกกลุ่มตามคนที่กินด้วยกันได้ เช่น ครอบครัว เพื่อนร่วมงาน หรือกลุ่มออกกำลังกาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aile, iş arkadaşları, spor ekibi gibi birlikte yemek yediğin her topluluk için ayrı bir grup tutabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể lập nhóm riêng cho từng nhóm người cùng ăn, như gia đình, đồng nghiệp hay hội bạn tập luyện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人、同事、运动搭子……和谁一起吃饭，就为谁单独建一个群组。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家人、同事、運動夥伴……每個一起吃飯的圈子，都可以各自建立群組。"
          }
        }
      }
    },
    "가족이나 친구에게 세끼 프로를 선물할 수 있어요. 받은 선물 코드도 설정에서 넣어요." : {
      "comment" : "Roadmap item detail: gift Pro to someone",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darujte Sekki Pro rodině nebo přátelům. Kód dárku, který dostanete, zadáte v nastavení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giv Sekki Pro til familie eller venner. En gavekode, du får, indløser du i indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schenke Sekki Pro deiner Familie oder Freunden. Erhaltene Geschenkcodes löst du in den Einstellungen ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χάρισε το Sekki Pro σε οικογένεια ή φίλους. Τον κωδικό δώρου που λαμβάνεις τον βάζεις στις Ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give Sekki Pro to family or friends. Redeem a gift code you receive in Settings."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give Sekki Pro to family or friends. Redeem a gift code you receive in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
