    "식전 사진 한 장으로 기록이 끝납니다. 식후 촬영 안내와 알림을 받지 않아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stačí jedna fotka před jídlem a máš hotovo. Žádné výzvy ani připomínky k focení po jídle."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ét foto før måltidet, og så er du færdig. Ingen opfordringer eller påmindelser om foto efter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto vor dem Essen, und der Eintrag ist fertig. Keine Hinweise oder Erinnerungen für ein Foto danach."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία φωτογραφία πριν το γεύμα και τελείωσες. Χωρίς υπενθυμίσεις για φωτογραφία μετά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One before photo and you’re done. No after-photo prompts or reminders."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One before photo and you’re done. No after-photo prompts or reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una foto de antes basta. Sin avisos ni recordatorios de foto de después."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi kuva ennen ateriaa riittää. Ei jälkeenkuvan kehotteita tai muistutuksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule photo avant le repas suffit. Ni invitation ni rappel pour la photo de fin de repas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cukup satu foto sebelum makan. Tidak ada ajakan atau pengingat foto sesudah makan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta una foto prima e hai finito. Niente richieste né promemoria per la foto dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食前の写真1枚で記録は完了です。食後の撮影案内や通知はありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식전 사진 한 장으로 기록이 끝납니다. 식후 촬영 안내와 알림을 받지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett bilde før måltidet, så er du ferdig. Ingen oppfordringer eller påminnelser om bilde etter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén foto voor het eten en je bent klaar. Geen aanwijzingen of herinneringen voor een foto na het eten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystarczy jedno zdjęcie przed posiłkiem. Bez próśb i przypomnień o zdjęciu po."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma foto antes de comer e pronto. Sem avisos nem lembretes de foto do depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одно фото до еды — и запись готова. Без напоминаний о фото после еды."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett foto före maten och du är klar. Inga uppmaningar eller påminnelser om efterbild."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แค่รูปก่อนกินรูปเดียวก็เสร็จ ไม่มีการเตือนให้ถ่ายรูปหลังกิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yemek öncesi tek bir fotoğrafla kayıt tamamlanır. Yemek sonrası fotoğraf istemi veya hatırlatması gelmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ cần một ảnh trước khi ăn là xong. Không có nhắc chụp ảnh sau bữa ăn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需一张餐前照片就算记录完成，不会提示拍餐后照片，也不会发提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只要一張飯前照片就完成記錄，不會有飯後拍照的提示和通知。"
          }
        }
      }
    },
