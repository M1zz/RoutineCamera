    "홈 맨 위에서 스탬프와 물 · 카페인을 바로 찍어요." : {
      "comment" : "Settings caption: the today check-in card shows at the top of Home",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razítka, vodu a kofein zapisujte hned nahoře na domovské obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt stempler og tæl vand og koffein øverst på forsiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel setzen und Wasser und Koffein zählen – direkt oben auf der Startseite."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλτε σφραγίδες και μετρήστε νερό και καφεΐνη στην κορυφή της αρχικής."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap stamps and count water and caffeine right at the top of Home."
          }
        },
        "en-GB" : {
          "stringUnit" : {
