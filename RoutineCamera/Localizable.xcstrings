        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upload eerdere registraties die alleen op deze telefoon staan naar iCloud, zodat je vrienden ze ook kunnen zien."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
