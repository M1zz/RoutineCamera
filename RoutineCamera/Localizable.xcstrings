    "운동한 날 사진 한 장이면 충분해요.\n모아 보면 꾸준함이 한눈에 보여요." : {
      "comment" : "A description of the benefits of having a collection of exercise photos.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo on the days you work out is all it takes.\nOver time, you’ll see your consistency at a glance."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동한 날 사진 한 장이면 충분해요.\n모아 보면 꾸준함이 한눈에 보여요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One photo on the days you work out is all it takes.\nOver time, you’ll see your consistency at a glance."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu foto di hari kamu berolahraga sudah cukup.\nLama-lama, konsistensimu terlihat sekilas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動した日は写真1枚でOKです。\n集まってくると、続けてきた成果がひと目でわかります。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันที่ออกกำลังกาย ถ่ายรูปแค่รูปเดียวก็พอ\nพอสะสมไปเรื่อย ๆ ก็เห็นความสม่ำเสมอได้ในพริบตา"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma foto nos dias em que você treina é tudo de que precisa.\nCom o tempo, você vê sua constância num relance."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运动的那天，拍一张照片就够了。\n攒起来，坚持的样子一目了然。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta una foto nei giorni in cui ti alleni.\nCol tempo vedrai la tua costanza a colpo d’occhio."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén foto op de dagen dat je sport is genoeg.\nMet de tijd zie je in één oogopslag hoe consistent je bent."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運動那天拍一張就夠了。\n累積起來，持之以恆的成果一目瞭然。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett bilde på treningsdagene er alt som skal til.\nMed tiden ser du jevnheten din med et blikk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wystarczy jedno zdjęcie w dniu treningu.\nZ czasem na pierwszy rzut oka zobaczysz swoją regularność."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett foto de dagar du tränar är allt som behövs.\nMed tiden ser du hur regelbunden du är."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В дни тренировок хватит одного фото.\nСо временем вы увидите свою регулярность с первого взгляда."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ét foto de dage, du træner, er alt, der skal til.\nMed tiden kan du se din vedholdenhed med et blik."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una foto los días que haces ejercicio es todo lo que necesitas.\nCon el tiempo, verás tu constancia de un vistazo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μία φωτογραφία τις ημέρες που προπονείσαι αρκεί.\nΜε τον καιρό θα βλέπεις τη συνέπειά σου με μια ματιά."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Foto an den Tagen, an denen du trainierst, reicht völlig.\nMit der Zeit siehst du deine Beständigkeit auf einen Blick."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày nào tập chỉ cần một tấm ảnh là đủ.\nTích lũy dần, bạn sẽ thấy sự đều đặn của mình ngay trong một cái nhìn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une photo les jours où vous vous entraînez, c’est tout ce qu’il faut.\nAvec le temps, votre régularité saute aux yeux."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi kuva treenipäivinä riittää.\nAjan myötä näet säännöllisyytesi yhdellä silmäyksellä."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve dnech, kdy cvičíš, stačí jedna fotka.\nPostupem času uvidíš svou pravidelnost na první pohled."
          }
        }
      }
    },
    "운동한 순간을 사진으로 툭 남겨보세요.\n채워야 할 칸은 없어요." : {
      "comment" : "A description of the empty state when the user hasn't taken any exercise photos.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Just snap a photo when you work out.\nThere are no boxes to fill."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동한 순간을 사진으로 툭 남겨보세요.\n채워야 할 칸은 없어요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
