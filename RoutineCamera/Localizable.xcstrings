    "아무것도 안 골라도 괜찮아요 — 알림 없이 원할 때만 기록해요." : {
      "comment" : "A description of the user's current meal preferences.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s fine to pick none. You’ll just log whenever you want, with no reminders."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 안 골라도 괜찮아요 — 알림 없이 원할 때만 기록해요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It’s fine to pick none. You’ll just log whenever you want, with no reminders."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak memilih juga tidak apa-apa. Kamu cukup mencatat kapan pun mau, tanpa pengingat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も選ばなくても大丈夫です。通知なしで、記録したいときだけ記録できます。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่เลือกเลยก็ได้ จะไม่มีการแจ้งเตือน บันทึกเมื่อไรก็ได้ที่อยากบันทึก"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não tem problema escolher nenhuma. Você registra quando quiser, sem lembretes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一个都不选也没关系——不会有提醒，想记的时候再记。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi anche non sceglierne nessuno: registrerai quando vuoi, senza promemoria."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hoeft niets te kiezen. Dan leg je vast wanneer je wilt, zonder herinneringen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "什麼都不選也沒關係，不會有提醒，想記錄時再記就好。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er greit å ikke velge noen. Da logger du bare når du vil, uten påminnelser."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz nic nie wybierać. Wtedy zapisujesz, kiedy chcesz, bez przypomnień."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går bra att inte välja något. Då loggar du när du vill, utan påminnelser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Можно ничего не выбирать: тогда напоминаний не будет, записывайте, когда захотите."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er helt fint ikke at vælge nogen. Så registrerer du bare, når du vil, uden påmindelser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pasa nada si no eliges ninguna. Registrarás cuando quieras, sin recordatorios."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν πειράζει να μην επιλέξεις κανένα. Θα καταγράφεις όποτε θες, χωρίς υπενθυμίσεις."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst auch keine auswählen. Dann trägst du einfach ein, wann du willst, ohne Erinnerungen."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không chọn bữa nào cũng được. Bạn cứ ghi khi nào muốn, không có nhắc nhở."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez n’en choisir aucun. Vous enregistrerez quand vous voulez, sans rappel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit jättää kaiken valitsematta. Kirjaat sitten milloin haluat, ilman muistutuksia."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klidně nevybírej nic. Zapisuješ, kdy chceš, bez připomínek."
          }
        }
      }
