          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube a iCloud los registros anteriores que solo están en este teléfono para que tus amigos también los vean."
          }
        },
        "el" : {
          "stringUnit" : {
