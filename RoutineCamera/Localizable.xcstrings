    "음식 이름이나 느낀 점을 간단히 메모해보세요" : {
      "comment" : "A description below the text editor for adding a note about the meal or the experience.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
