        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κράτα ιδιωτικό το ημερολόγιο γευμάτων σου με Face ID ή Touch ID όταν ανοίγεις την εφαρμογή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your meal log private with Face ID or Touch ID when you open the app."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep your meal log private with Face ID or Touch ID when you open the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege tu registro de comidas con Face ID o Touch ID al abrir la app."
