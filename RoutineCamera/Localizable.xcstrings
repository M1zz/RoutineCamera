    "먹기 전에 사진 한 장 남겨요. 누르면 바로 카메라가 열려요." : {
      "comment" : "Meal reminder notification body",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyfoť jídlo ještě před jídlem. Klepnutím otevřeš fotoaparát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag et foto, før du spiser. Tryk for at åbne kameraet med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach vor dem Essen ein Foto. Tippe, um die Kamera zu öffnen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τράβηξε μια φωτογραφία πριν φας. Πάτα για να ανοίξει η κάμερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap a photo before you eat. Tap to open the camera."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap a photo before you eat. Tap to open the camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saca una foto antes de comer. Toca para abrir la cámara directamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota kuva ennen syömistä. Napauta, niin kamera aukeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prenez une photo avant de manger. Touchez pour ouvrir l’appareil photo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto dulu sebelum makan. Ketuk untuk langsung membuka kamera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scatta una foto prima di mangiare. Tocca per aprire la fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食べる前に写真を1枚撮りましょう。タップするとカメラが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먹기 전에 사진 한 장 남겨요. 누르면 바로 카메라가 열려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta et bilde før du spiser. Trykk for å åpne kameraet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak een foto voordat je gaat eten. Tik om de camera te openen."
          }
        },
        "pl" : {
