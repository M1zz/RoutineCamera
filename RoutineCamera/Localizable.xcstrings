    "식전·식후 두 장으로 기록합니다. 다 먹은 뒤 \"다 드셨어요?\" 알림을 받아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každé jídlo zapíšeš dvěma fotkami, před jídlem a po něm. Po jídle ti přijde připomínka „Dojedeno?“."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrer hvert måltid med et foto før og efter. Du får en påmindelse, “Er du færdig?”, når du har spist."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hältst jede Mahlzeit mit einem Foto vorher und einem nachher fest. Nach dem Essen bekommst du die Erinnerung „Schon aufgegessen?“."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατέγραψε κάθε γεύμα με μία φωτογραφία πριν και μία μετά. Μετά το φαγητό θα λαμβάνεις υπενθύμιση «Τελείωσες;»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log each meal with a before and an after photo. You’ll get a “Finished?” reminder after you eat."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log each meal with a before and an after photo. You’ll get a “Finished?” reminder after you eat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra cada comida con una foto de antes y otra de después. Cuando termines de comer, recibirás un aviso de “¿Terminaste?”."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaa jokainen ateria kuvalla ennen ja jälkeen. Saat ”Onko ateria syöty?” -muistutuksen syömisen jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez chaque repas avec une photo avant et une photo après. Vous recevrez un rappel « Vous avez fini ? » après le repas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat setiap makan dengan foto sebelum dan sesudah. Kamu akan dapat pengingat “Sudah selesai?” setelah makan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra ogni pasto con una foto prima e una dopo. Dopo aver mangiato riceverai una notifica “Hai finito?”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食前と食後の2枚で記録します。食べ終わったころに「食べ終わりましたか？」という通知が届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식전·식후 두 장으로 기록합니다. 다 먹은 뒤 \"다 드셨어요?\" 알림을 받아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logg hvert måltid med bilde før og etter. Du får en «Ferdig?»-påminnelse etter at du har spist."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg elke maaltijd vast met een foto voor en een foto na het eten. Na het eten krijg je een herinnering “Opgegeten?”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj każdy posiłek zdjęciem przed i po. Po jedzeniu dostaniesz przypomnienie „Zjedzone?”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre cada refeição com uma foto de antes e outra de depois. Depois de comer, você recebe um lembrete “Terminou?”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте каждый приём пищи двумя фото: до и после еды. Когда поедите, придёт напоминание «Доели?»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga varje måltid med en bild före och en efter. Du får en påminnelse, ”Har du ätit klart?”, efter måltiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกแต่ละมื้อด้วยรูปก่อนกินและหลังกิน เมื่อกินเสร็จจะมีแจ้งเตือน “กินหมดแล้วหรือยัง”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her öğünü yemek öncesi ve sonrası fotoğrafla kaydet. Yedikten sonra “Bitirdin mi?” hatırlatması alırsın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi mỗi bữa bằng hai ảnh, trước và sau khi ăn. Ăn xong, bạn sẽ nhận nhắc nhở “Ăn xong rồi chứ?”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用餐前和餐后各拍一张来记录。吃完后会收到“吃完了吗？”提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用飯前和飯後兩張照片記錄每一餐。吃完後會收到「吃完了嗎？」通知。"
          }
        }
      }
    },
