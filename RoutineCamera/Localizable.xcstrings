    "사진 속 음식을 휴대폰 안에서 알아보고 기록에 이름표를 붙입니다. 사진은 밖으로 나가지 않아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpozná jídlo na fotkách přímo v telefonu a označí tvé záznamy. Fotky telefon neopustí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genkender maden på dine fotos direkte på din telefon og sætter mærker på dine registreringer. Dine fotos forlader aldrig din enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt die Speisen auf deinen Fotos direkt auf deinem Gerät und versieht deine Einträge mit Labels. Deine Fotos verlassen dein Gerät nie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναγνωρίζει τα φαγητά στις φωτογραφίες σου απευθείας στο τηλέφωνό σου και προσθέτει ετικέτες στις καταγραφές σου. Οι φωτογραφίες σου δεν φεύγουν ποτέ από τη συσκευή."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognizes the food in your photos right on your phone and tags your entries. Your photos never leave your device."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recognises the food in your photos right on your phone and tags your entries. Your photos never leave your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconoce los alimentos de tus fotos directamente en tu teléfono y etiqueta tus registros. Tus fotos nunca salen de tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunnistaa kuviesi ruoat suoraan puhelimessa ja lisää kirjauksiin tunnisteet. Kuvasi eivät poistu laitteeltasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnaît les aliments de vos photos directement sur votre appareil et ajoute des étiquettes à vos enregistrements. Vos photos ne le quittent jamais."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengenali makanan di fotomu langsung di ponsel dan memberi label pada catatanmu. Fotomu tidak pernah keluar dari perangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosce i cibi nelle tue foto direttamente sul telefono e aggiunge etichette alle registrazioni. Le foto non lasciano mai il dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真に写った食べ物を、iPhone上で認識して記録にタグを付けます。写真が外部に送信されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진 속 음식을 휴대폰 안에서 알아보고 기록에 이름표를 붙입니다. 사진은 밖으로 나가지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjenkjenner maten på bildene dine direkte på telefonen og merker oppføringene. Bildene dine forlater aldri enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herkent het eten op je foto’s direct op je telefoon en voorziet je registraties van labels. Je foto’s verlaten je apparaat nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpoznaje jedzenie na zdjęciach bezpośrednio w telefonie i oznacza wpisy. Zdjęcia nigdy nie opuszczają urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconhece os alimentos das suas fotos no próprio celular e marca seus registros. Suas fotos nunca saem do aparelho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознаёт еду на фото прямо на телефоне и добавляет к записям метки. Фото не покидают устройство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Känner igen maten i dina foton direkt på telefonen och sätter etiketter på dina inlägg. Dina foton lämnar aldrig enheten."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดจำอาหารในรูปบนโทรศัพท์ของคุณเอง แล้วติดป้ายชื่อให้บันทึก รูปจะไม่ออกจากอุปกรณ์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoğraflarındaki yiyecekleri doğrudan telefonunda tanır ve kayıtlarına etiket ekler. Fotoğrafların cihazından hiç çıkmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận diện món ăn trong ảnh ngay trên điện thoại và gắn nhãn cho bản ghi. Ảnh của bạn không bao giờ rời khỏi thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在手机上识别照片中的食物，并给记录加上标签。照片不会离开你的设备。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接在手機上辨識照片中的食物，並為記錄加上標籤。照片不會離開你的裝置。"
          }
        }
      }
    },
