    "빈 칸 없이 남긴 기록만 시간순으로 쌓이는 사진 일기 방식입니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotodeník jen z toho, co zapíšeš, řazený podle času. Žádná prázdná políčka."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En fotodagbog kun med det, du har registreret, i tidsrækkefølge. Ingen tomme felter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fotojournal nur mit dem, was du eingetragen hast, in zeitlicher Reihenfolge. Keine leeren Felder."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ένα φωτογραφικό ημερολόγιο μόνο με όσα κατέγραψες, με χρονολογική σειρά. Χωρίς κενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A photo diary of only what you logged, in time order. No empty slots."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A photo diary of only what you logged, in time order. No empty slots."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un diario de fotos con solo lo que registras, en orden cronológico. Sin casillas vacías."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valokuvapäiväkirja, jossa on vain kirjaamasi asiat aikajärjestyksessä. Ei tyhjiä ruutuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un journal photo qui ne garde que ce que vous enregistrez, dans l’ordre chronologique. Aucune case vide."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buku harian foto yang hanya berisi catatanmu, berurutan menurut waktu. Tanpa kolom kosong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un diario fotografico con solo ciò che registri, in ordine di tempo. Nessuna casella vuota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空白の枠なしで、残した記録だけが時系列に並ぶ写真日記です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빈 칸 없이 남긴 기록만 시간순으로 쌓이는 사진 일기 방식입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En bildedagbok med bare det du har logget, i tidsrekkefølge. Ingen tomme ruter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een fotodagboek met alleen wat je hebt vastgelegd, in tijdsvolgorde. Geen lege vakjes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziennik ze zdjęć, w którym są tylko Twoje wpisy w kolejności czasowej. Bez pustych pól."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um diário de fotos só com o que você registrou, em ordem de horário. Sem campos vazios."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотодневник только из ваших записей в хронологическом порядке. Без пустых ячеек."
