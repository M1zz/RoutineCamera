    "친구가 사진을 올리면 알려 드려요. 한 친구가 여러 끼를 한꺼번에 올려도 알림은 하나로 모아요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dáme ti vědět, když přítel nahraje fotku. Pokud nahraje víc jídel najednou, přijde jen jedno oznámení."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få besked, når en ven lægger et foto op. Lægger en ven flere måltider op på én gang, får du kun én notifikation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du wirst benachrichtigt, wenn ein Freund ein Foto postet. Postet jemand mehrere Mahlzeiten auf einmal, bekommst du nur eine Mitteilung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ειδοποιείσαι όταν ένας φίλος αναρτά φωτογραφία. Αν ένας φίλος αναρτήσει πολλά γεύματα μαζί, θα λάβεις μία μόνο ειδοποίηση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notified when a friend posts a photo. If a friend posts several meals at once, you’ll get just one alert."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get notified when a friend posts a photo. If a friend posts several meals at once, you’ll get just one alert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos cuando un amigo publique una foto. Si publica varias comidas a la vez, recibirás un solo aviso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ilmoituksen, kun kaveri lisää kuvan. Jos kaveri kirjaa useita aterioita kerralla, saat vain yhden ilmoituksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soyez averti quand un ami publie une photo. S’il publie plusieurs repas d’un coup, vous ne recevrez qu’une seule alerte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapatkan notifikasi saat teman mengunggah foto. Jika teman mengunggah beberapa makan sekaligus, kamu hanya mendapat satu notifikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi una notifica quando un amico pubblica una foto. Se un amico pubblica più pasti insieme, ricevi un solo avviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フレンドが写真を投稿するとお知らせします。1人のフレンドが複数の食事をまとめて投稿しても、通知は1つにまとめます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "친구가 사진을 올리면 알려 드려요. 한 친구가 여러 끼를 한꺼번에 올려도 알림은 하나로 모아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få varsel når en venn legger ut et bilde. Hvis en venn legger ut flere måltider samtidig, får du bare ett varsel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontvang een melding wanneer een vriend een foto plaatst. Plaatst een vriend meerdere maaltijden tegelijk, dan krijg je maar één melding."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomimy Cię, gdy znajomy doda zdjęcie. Jeśli doda kilka posiłków naraz, dostaniesz tylko jedno powiadomienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisamos quando um amigo postar uma foto. Se ele postar várias refeições de uma vez, você recebe só um aviso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы сообщим, когда друг добавит фото. Если друг добавит сразу несколько приёмов пищи, придёт одно уведомление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en notis när en vän lägger upp ett foto. Om en vän lägger upp flera måltider samtidigt får du bara en notis."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจะแจ้งเมื่อเพื่อนโพสต์รูป ถ้าเพื่อนโพสต์หลายมื้อพร้อมกัน จะรวมเป็นการแจ้งเตือนเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir arkadaşın fotoğraf paylaştığında bildirim al. Bir arkadaşın aynı anda birkaç öğün paylaşırsa tek bir bildirim gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận thông báo khi bạn bè đăng ảnh. Nếu một người bạn đăng nhiều bữa cùng lúc, bạn chỉ nhận một thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好友发布照片时通知你。好友一次发布多餐时，也只合并成一条提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朋友上傳照片時會通知你。就算朋友一次上傳好幾餐，也只會合併成一則通知。"
          }
        }
      }
    },
