        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事の写真を記録しています。オンにすると運動の記録に切り替わります。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตอนนี้บันทึกรูปมื้ออาหารอยู่ เปิดเพื่อสลับไปบันทึกการออกกำลังกาย"
