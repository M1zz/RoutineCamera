    "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요." : {
      "comment" : "Roadmap item detail: layouts for larger text",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ani s větším písmem se nic neořízne a vše se přehledně přeskupí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med større tekst bliver intet skåret af, og alt placeres pænt igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch bei großer Schrift wird nichts abgeschnitten, alles ordnet sich übersichtlich neu."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ακόμη και με μεγάλο κείμενο τίποτα δεν κόβεται και όλα αναδιατάσσονται τακτοποιημένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even with larger text, nothing gets cut off and everything rearranges neatly."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even with larger text, nothing gets cut off and everything rearranges neatly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque agrandes el texto, nada se corta y todo se reorganiza con orden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suurellakaan tekstillä mitään ei leikkaudu, vaan kaikki asettuu siististi uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Même en grand texte, rien n’est coupé et tout se réorganise proprement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meski teks diperbesar, tidak ada yang terpotong dan semuanya tertata ulang dengan rapi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche con il testo grande nulla viene tagliato e tutto si riordina con cura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字を大きくしても切れずに、見やすく並び直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글자 크기를 키워도 잘리지 않고 보기 좋게 다시 배치돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selv med større tekst blir ingenting kuttet, og alt ordnes pent på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ook met grotere tekst valt er niets weg en wordt alles netjes opnieuw geschikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nawet przy większym tekście nic się nie ucina, a wszystko ładnie się układa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesmo com texto maior, nada fica cortado e tudo se reorganiza direitinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
