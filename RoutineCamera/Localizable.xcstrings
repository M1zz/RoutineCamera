    "챙길 것은 먹은 날에, 줄일 것은 참은 날에 찍어요. 빼도 지난 기록은 남아요." : {
      "comment" : "Footer explaining how stamps work",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamp “Eat more” items on days you had them and “Cut down” items on days you went without. Removing a stamp keeps its past records."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamp “Eat more” items on days you had them and “Cut down” items on days you went without. Removing a stamp keeps its past records."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Jíst víc“ razítkuj ve dny, kdy to jíš, „Omezit“ ve dny, kdy se bez toho obejdeš. Když razítko odebereš, starší záznamy zůstanou."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempl „Spis mere“ på dage, hvor du fik det, og „Skær ned“ på dage, hvor du lod være. Fjerner du et stempel, bliver tidligere registreringer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze „Mehr essen“ an Tagen, an denen du es gegessen hast, und „Weniger“ an Tagen, an denen du verzichtet hast. Entfernst du einen Stempel, bleiben frühere Einträge erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε σφραγίδα στο «Τρώω πιο συχνά» τις μέρες που το έφαγες και στο «Κόβω» τις μέρες που το απέφυγες. Αν αφαιρέσεις μια σφραγίδα, οι παλιές καταγραφές μένουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sella «Comer más» los días que lo comiste y «Reducir» los días que lo evitaste. Si quitas un sello, los registros anteriores se conservan."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leimaa ”Syö enemmän” päivinä, jolloin söit sitä, ja ”Vähennä” päivinä, jolloin jätit sen väliin. Kun poistat leiman, aiemmat merkinnät säilyvät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamponnez « À privilégier » les jours où vous en avez mangé, et « À limiter » les jours où vous vous en êtes passé. Retirer un tampon ne supprime pas l'historique."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri stempel “Perbanyak” di hari kamu memakannya, dan “Kurangi” di hari kamu menahannya. Kalau stempel dihapus, catatan lamanya tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbra “Da mangiare di più” nei giorni in cui l'hai mangiato e “Da ridurre” nei giorni in cui ne hai fatto a meno. Se togli un timbro, i dati passati restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「とりたいもの」は食べた日に、「控えたいもの」はがまんできた日に押します。外しても過去の記録は残ります。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemple «Spis mer» på dager du fikk det, og «Kutt ned» på dager du lot være. Fjerner du et stempel, blir tidligere registreringer liggende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel ‘Meer eten’ op dagen dat je het at en ‘Minderen’ op dagen dat je het liet staan. Haal je een stempel weg, dan blijven eerdere gegevens bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Więcej” stempluj w dni, gdy to jesz, a „Mniej” w dni, gdy uda się odpuścić. Po usunięciu pieczątki wcześniejsze wpisy zostają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carimbe “Comer mais” nos dias em que comeu e “Diminuir” nos dias em que evitou. Se remover um carimbo, os registros anteriores continuam salvos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Есть больше» отмечайте в дни, когда ели это, а «Сократить» — в дни, когда удалось обойтись без. Если убрать отметку, прошлые записи сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stämpla ”Ät mer” de dagar du åt det och ”Dra ner på” de dagar du avstod. Tar du bort en stämpel finns tidigare anteckningar kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“กินให้มากขึ้น” ประทับในวันที่ได้กิน “ลดลง” ประทับในวันที่อดใจได้ ลบแสตมป์ออกไปแล้วบันทึกเก่ายังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Daha çok ye” damgasını yediğin günlere, “Azalt” damgasını uzak durduğun günlere vur. Bir damgayı kaldırsan da eski kayıtlar kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục “Ăn thêm” đóng dấu vào ngày đã ăn, mục “Hạn chế” đóng vào ngày đã nhịn được. Bỏ dấu đi thì các ghi chép cũ vẫn còn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“多吃点”在吃了的那天盖章，“少吃点”在忍住的那天盖章。移除印章后，以往记录仍会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「多吃點」在吃了的那天蓋章，「少吃點」在忍住的那天蓋章。移除印章後，過去的紀錄仍會保留。"
          }
        }
      }
    },
