        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suojaa ateriakirjauksesi Face ID:llä tai Touch ID:llä, kun avaat apin."
          }
        },
        "fr" : {
          "stringUnit" : {
