          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the features you need, monthly, yearly or for life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige las funciones que necesites: mensual, anual o de por vida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse tarvitsemasi ominaisuudet kuukaudeksi, vuodeksi tai pysyvästi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les fonctions qu’il vous faut : au mois, à l’année ou à vie."
