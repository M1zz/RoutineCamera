    "지난 달 달력을 넘겨 보고, 스탬프마다 몇 번 찍었는지와 며칠째 이어 가는지 봐요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flip through past months and see how often you used each stamp and how long your streaks run."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flip through past months and see how often you used each stamp and how long your streaks run."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listuj minulými měsíci a sleduj, kolikrát padlo které razítko a jak dlouhé máš série."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bladr i tidligere måneder, og se hvor tit du har brugt hvert stempel, og hvor lange dine stimer er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blättere durch frühere Monate und sieh, wie oft du jeden Stempel gesetzt hast und wie lang deine Serien sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ξεφύλλισε παλιότερους μήνες και δες πόσες φορές έβαλες κάθε σφραγίδα και πόσο κρατάνε τα σερί σου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorre meses anteriores y mira cuántas veces usaste cada sello y cuánto duran tus rachas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selaa menneitä kuukausia ja katso, kuinka usein käytit kutakin leimaa ja kuinka pitkiä putkesi ovat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez les mois passés et voyez combien de fois vous avez utilisé chaque tampon et la durée de vos séries."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telusuri bulan-bulan lalu dan lihat seberapa sering kamu memakai tiap stempel serta berapa hari runtutanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfoglia i mesi passati e scopri quante volte hai usato ogni timbro e quanto durano le tue serie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去の月をめくって、スタンプごとの回数と何日続いているかを確認できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bla i tidligere måneder og se hvor ofte du har brukt hvert stempel, og hvor lange rekkene dine er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blader door eerdere maanden en zie hoe vaak je elke stempel hebt gezet en hoe lang je reeksen zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj minione miesiące i sprawdzaj, ile razy użyto każdej pieczątki i jak długie są Twoje serie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navegue pelos meses anteriores e veja quantas vezes usou cada carimbo e quanto duram suas sequências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Листайте прошлые месяцы и смотрите, сколько раз ставили каждую отметку и сколько дней подряд держитесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bläddra bland tidigare månader och se hur ofta du använt varje stämpel och hur långa dina sviter är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้อนดูปฏิทินเดือนก่อน ๆ ดูว่าแต่ละแสตมป์ประทับไปกี่ครั้ง และทำต่อเนื่องมาแล้วกี่วัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmiş aylara göz at; her damgayı kaç kez vurduğunu ve kaç gündür sürdürdüğünü gör."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lật lại các tháng trước, xem mỗi dấu đã đóng bao nhiêu lần và bạn đã duy trì liên tục bao nhiêu ngày."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻看以往月份，查看每个印章盖了几次、已经连续坚持了几天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻看以往月份，查看每個印章蓋了幾次、已經連續維持了幾天。"
          }
        }
      }
    },
