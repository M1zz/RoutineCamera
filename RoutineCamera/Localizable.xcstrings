    "앱을 열 때 Face ID나 Touch ID로 내 식단 기록을 지켜요." : {
      "comment" : "Text displayed in a list item for the \"Face ID 잠기기\" feature in the subscription paywall.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při otevření aplikace chraň své záznamy pomocí Face ID nebo Touch ID."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold dit måltidslog privat med Face ID eller Touch ID, når du åbner appen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schütze dein Mahlzeitenjournal beim Öffnen der App mit Face ID oder Touch ID."
