    "신고했어요. 확인한 뒤 조치할게요." : {
      "comment" : "Result: report sent and will be reviewed",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Děkujeme za nahlášení. Zkontrolujeme to a podnikneme kroky."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak for din anmeldelse. Vi gennemgår den og griber ind."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke für deine Meldung. Wir prüfen sie und ergreifen bei Bedarf Maßnahmen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ευχαριστούμε για την αναφορά. Θα την εξετάσουμε και θα ενεργήσουμε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for reporting. We’ll review it and take action."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for reporting. We’ll review it and take action."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por avisar. Lo revisaremos y tomaremos medidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiitos ilmoituksesta. Tarkistamme sen ja ryhdymme toimiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci pour votre signalement. Nous allons l’examiner et agir en conséquence."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih sudah melapor. Kami akan meninjau dan mengambil tindakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per la segnalazione. La esamineremo e interverremo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "報告しました。内容を確認のうえ、対応します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신고했어요. 확인한 뒤 조치할게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk for rapporten. Vi går gjennom den og tar affære."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedankt voor je melding. We bekijken deze en nemen actie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziękujemy za zgłoszenie. Sprawdzimy je i podejmiemy działania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado por denunciar. Vamos analisar e tomar as providências."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за жалобу. Мы проверим её и примем меры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tack för din rapport. Vi granskar den och vidtar åtgärder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอบคุณที่รายงาน เราจะตรวจสอบและดำเนินการ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirdiğin için teşekkürler. İnceleyip gereğini yapacağız."
