    "몇 주 전과 지금의 식사를 나란히 보고, 자주 먹은 음식을 모아 봐요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare your meals from a few weeks ago with today, and see the foods you eat most."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 주 전과 지금의 식사를 나란히 보고, 자주 먹은 음식을 모아 봐요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare your meals from a few weeks ago with today, and see the foods you eat most."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan makananmu beberapa minggu lalu dengan hari ini, dan lihat makanan yang paling sering kamu santap."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数週間前と今日の食事を並べて見比べたり、よく食べるものをまとめて確認したりできます。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทียบมื้อเมื่อหลายสัปดาห์ก่อนกับวันนี้ และดูอาหารที่กินบ่อย"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare suas refeições de algumas semanas atrás com as de hoje e veja os alimentos que você mais come."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把几周前的饮食和现在并排对比，还能看到常吃的食物。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta i pasti di qualche settimana fa con quelli di oggi e scopri quali cibi mangi di più."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk je maaltijden van een paar weken geleden met die van vandaag en zie wat je het vaakst eet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把幾週前和現在的餐點並排比較，也能看看常吃的食物。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign måltider fra for noen uker siden med i dag, og se maten du spiser mest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porównaj posiłki sprzed kilku tygodni z dzisiejszymi i zobacz, co jadasz najczęściej."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför dina måltider från några veckor sedan med dagens och se vad du äter oftast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравнивайте питание несколько недель назад и сейчас и смотрите, что вы едите чаще всего."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign dine måltider fra for et par uger siden med i dag, og se, hvad du spiser mest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara tus comidas de hace unas semanas con las de hoy y mira qué alimentos comes más."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύγκρινε τα γεύματά σου από πριν από μερικές εβδομάδες με τα σημερινά και δες ποια φαγητά τρως συχνότερα."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche deine Mahlzeiten von vor ein paar Wochen mit heute und sieh, was du am häufigsten isst."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt bữa ăn của vài tuần trước cạnh hôm nay để so sánh, và xem những món bạn hay ăn nhất."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez vos repas d’il y a quelques semaines à ceux d’aujourd’hui et retrouvez les aliments que vous mangez le plus."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa muutaman viikon takaisia aterioita tämänpäiväisiin ja katso, mitä syöt eniten."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porovnej jídla před několika týdny s dneškem a podívej se, co jíš nejčastěji."
          }
        }
      }
    },
