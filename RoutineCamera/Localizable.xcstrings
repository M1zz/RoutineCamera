          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族や友だちにSekki Proを贈れます。受け取ったギフトコードも設定から入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족이나 친구에게 세끼 프로를 선물할 수 있어요. 받은 선물 코드도 설정에서 넣어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gi Sekki Pro til familie eller venner. En gavekode du får, løser du inn i innstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Sekki Pro cadeau aan familie of vrienden. Een ontvangen cadeaucode wissel je in bij Instellingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podaruj Sekki Pro rodzinie lub znajomym. Otrzymany kod prezentu wpiszesz w ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
