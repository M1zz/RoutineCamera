        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы записываете фото тренировок. Питание и тренировки хранятся отдельно."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du registrerer fotos af træning. Måltider og træning gemmes hver for sig."
