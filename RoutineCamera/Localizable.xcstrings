    "연어, 채소처럼 챙길 것은 먹은 날에, 설탕, 야식처럼 줄일 것은 참은 날에 찍어 달력으로 돌아봐요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamp foods like salmon and vegetables on days you eat them, and things like sugar and late-night snacks on days you skip them. Then look back on a calendar."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stamp foods like salmon and vegetables on days you eat them, and things like sugar and late-night snacks on days you skip them. Then look back on a calendar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lososa nebo zeleninu razítkuj ve dny, kdy je jíš, cukr nebo jídlo v noci ve dny, kdy se bez nich obejdeš. Pak se ohlédni v kalendáři."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempl fx laks og grøntsager på dage, du spiser dem, og sukker og natmad på dage, du lader være. Se så tilbage i kalenderen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel Lachs oder Gemüse an Tagen, an denen du sie isst, und Zucker oder Spätsnacks an Tagen, an denen du verzichtest. Im Kalender siehst du alles auf einen Blick."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βάλε σφραγίδα σε σολομό ή λαχανικά τις μέρες που τα τρως, και σε ζάχαρη ή βραδινό σνακ τις μέρες που τα αποφεύγεις. Μετά δες τα όλα στο ημερολόγιο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sella el salmón o las verduras los días que los comas, y el azúcar o picar de noche los días que lo evites. Luego repásalo todo en un calendario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leimaa lohi tai kasvikset päivinä, jolloin syöt niitä, ja sokeri tai iltanapostelu päivinä, jolloin jätät ne väliin. Katso sitten kaikki kalenterista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamponnez le saumon ou les légumes les jours où vous en mangez, et le sucre ou le grignotage tardif les jours où vous vous en passez. Puis revoyez tout dans un calendrier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri stempel untuk salmon atau sayur di hari kamu memakannya, dan gula atau ngemil malam di hari kamu menahannya. Lalu lihat lagi di kalender."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timbra salmone o verdure nei giorni in cui li mangi, e zucchero o snack notturni nei giorni in cui ne fai a meno. Poi rivedi tutto nel calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サケや野菜のようにとりたいものは食べた日に、砂糖や夜食のように控えたいものはがまんできた日に押して、カレンダーで振り返れます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemple laks og grønnsaker på dager du spiser dem, og sukker og nattmat på dager du lar være. Se så tilbake i kalenderen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempel zalm of groente op dagen dat je het eet, en suiker of late snacks op dagen dat je het laat staan. Blik daarna terug in de kalender."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stempluj łososia czy warzywa w dni, gdy je jesz, a cukier czy nocne podjadanie w dni, gdy uda się odpuścić. Potem wszystko zobaczysz w kalendarzu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carimbe salmão ou verduras nos dias em que comer, e açúcar ou lanche à noite nos dias em que evitar. Depois reveja tudo em um calendário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте лосось или овощи в дни, когда их едите, а сахар или ночные перекусы — в дни, когда обошлись без них. А потом смотрите всё в календаре."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stämpla lax eller grönsaker de dagar du äter dem, och socker eller nattsnack de dagar du avstår. Se sedan tillbaka i en kalender."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ของที่ควรกิน เช่น แซลมอน ผัก ประทับในวันที่ได้กิน ของที่ควรลด เช่น น้ำตาล มื้อดึก ประทับในวันที่อดใจได้ แล้วย้อนดูในปฏิทิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somon, sebze gibi yiyeceklere yediğin günlerde, şeker ve gece atıştırması gibi şeylere uzak durduğun günlerde damga vur. Sonra hepsine takvimde göz at."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đóng dấu cá hồi, rau vào ngày đã ăn, đường hay ăn khuya vào ngày đã nhịn được, rồi xem lại trên lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三文鱼、蔬菜这类想多吃的，吃了就盖章；糖、夜宵这类想少吃的，忍住了就盖章，再用日历回顾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鮭魚、蔬菜這類想多吃的，吃了就蓋章；糖、宵夜這類想少吃的，忍住了就蓋章，再用月曆回顧。"
          }
        }
      }
    },
    "열량을 세는 대신 다, 절반, 조금으로 남겨 먹는 양이 줄어드는 걸 봐요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No counting. Just mark All, Half or A little and watch your portions get smaller."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No counting. Just mark All, Half or A little and watch your portions get smaller."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné počítání. Stačí zvolit Vše, Polovina nebo Trochu a sledovat, jak se porce zmenšují."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen tællen. Vælg bare Alt, Halvdelen eller Lidt, og se dine portioner blive mindre."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne Zählen: Wähle einfach Alles, Hälfte oder Ein wenig und sieh, wie deine Portionen kleiner werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωρίς μετρήματα. Διάλεξε Όλο, Μισό ή Λίγο και δες τις μερίδες σου να μικραίνουν."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin contar nada. Marca Todo, Mitad o Un poco y mira cómo tus porciones se hacen más pequeñas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei laskemista. Valitse Kaikki, Puolet tai Vähän ja näe, miten annokset pienenevät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à compter : indiquez Tout, Moitié ou Un peu, et voyez vos portions diminuer."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa menghitung. Cukup tandai Habis, Setengah, atau Sedikit, lalu lihat porsimu makin kecil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente conti. Segna Tutto, Metà o Un po' e guarda le porzioni diventare più piccole."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数字を数える代わりに「全部・半分・少し」で残して、食べる量が減っていくのを見られます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen telling. Velg Alt, Halvparten eller Litt, og se porsjonene bli mindre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets tellen. Kies Alles, Helft of Een beetje en zie je porties kleiner worden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez liczenia. Zaznacz Całość, Połowa albo Trochę i patrz, jak porcje się zmniejszają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem contar nada. Marque Tudo, Metade ou Um pouco e veja suas porções diminuírem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ничего не нужно считать: отмечайте «Всё», «Половина» или «Немного» и смотрите, как порции становятся меньше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget räknande. Välj Allt, Hälften eller Lite och se portionerna bli mindre."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องนับตัวเลข แค่เลือก หมด ครึ่งหนึ่ง หรือ นิดหน่อย แล้วดูปริมาณที่กินค่อย ๆ ลดลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiçbir şey saymadan Hepsi, Yarısı ya da Biraz olarak işaretle, porsiyonlarının küçüldüğünü gör."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần đếm số, chỉ chọn Hết, Một nửa hay Một ít và xem khẩu phần nhỏ dần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用算数字，只要选“全部”“一半”“一点”，就能看到饭量慢慢变少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用算數字，只要選「全部」「一半」「一點」，就能看到食量慢慢變少。"
          }
        }
      }
