        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirimin doğrudan geliştiriciye iletilir. Karşı taraf bilgilendirilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Báo cáo của bạn được gửi thẳng đến nhà phát triển. Người kia sẽ không được thông báo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
