    "선택한 식사가 없어 알림을 받지 않아요. 원할 때만 기록하세요." : {
      "comment" : "A description of the `caredMeals` section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nejsou vybrána žádná jídla, takže ti nepřijdou připomínky. Zapisuj, kdy chceš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke valgt nogen måltider, så du får ingen påmindelser. Registrer, når det passer dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Mahlzeit ausgewählt, daher bekommst du keine Erinnerungen. Trag einfach ein, wann du magst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν έχεις επιλέξει γεύματα, οπότε δεν θα λαμβάνεις υπενθυμίσεις. Κατάγραψε όποτε θέλεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No meals selected, so you won’t get reminders. Log whenever you like."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No meals selected, so you won’t get reminders. Log whenever you like."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay comidas seleccionadas, así que no recibirás recordatorios. Registra cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei valittuja aterioita, joten et saa muistutuksia. Kirjaa milloin haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun repas sélectionné, donc aucun rappel. Enregistrez quand vous voulez."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada waktu makan yang dipilih, jadi kamu tidak akan dapat pengingat. Catat kapan pun kamu mau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun pasto selezionato, quindi non riceverai promemoria. Registra quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事を選んでいないので、通知は届きません。記録したいときだけ記録しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 식사가 없어 알림을 받지 않아요. 원할 때만 기록하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen måltider er valgt, så du får ingen påminnelser. Logg når du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen maaltijden geselecteerd, dus je krijgt geen herinneringen. Leg vast wanneer je maar wilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie wybrano posiłków, więc nie dostaniesz przypomnień. Zapisuj, kiedy chcesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma refeição selecionada, então você não vai receber lembretes. Registre quando quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приёмы пищи не выбраны, поэтому напоминаний не будет. Записывайте, когда захотите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
