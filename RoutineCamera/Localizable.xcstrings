    "되찾을 구매가 없어요. 산 Apple 계정으로 로그인했는지 확인해 주세요." : {
      "comment" : "Settings: restore purchases found nothing",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádné nákupy k obnovení. Zkontrolujte, že jste přihlášeni Apple účtem, kterým jste nakupovali."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen køb at gendanne. Tjek, at du er logget ind med den Apple-konto, du købte med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Käufe zum Wiederherstellen. Prüfe, ob du mit dem Apple Account angemeldet bist, mit dem du gekauft hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν υπάρχουν αγορές για επαναφορά. Βεβαιωθείτε ότι έχετε συνδεθεί με τον Λογαριασμό Apple της αγοράς."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No purchases to restore. Make sure you’re signed in with the Apple Account you used to buy."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No purchases to restore. Make sure you’re signed in with the Apple Account you used to buy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay compras que restaurar. Comprueba que iniciaste sesión con la cuenta de Apple con la que compraste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautettavia ostoja ei ole. Varmista, että olet kirjautunut Apple-tilillä, jolla ostit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat à restaurer. Vérifiez que vous êtes connecté avec le compte Apple utilisé pour l’achat."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada pembelian untuk dipulihkan. Pastikan kamu masuk dengan Akun Apple yang dipakai membeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun acquisto da ripristinare. Controlla di aver eseguito l’accesso con l’Account Apple usato per l’acquisto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元できる購入がありません。購入したAppleアカウントでサインインしているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "되찾을 구매가 없어요. 산 Apple 계정으로 로그인했는지 확인해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen kjøp å gjenopprette. Sjekk at du er logget på med Apple-kontoen du kjøpte med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen aankopen om te herstellen. Controleer of je bent ingelogd met het Apple Account waarmee je hebt gekocht."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak zakupów do przywrócenia. Sprawdź, czy logujesz się kontem Apple użytym do zakupu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há compras para restaurar. Verifique se você entrou com a Conta Apple usada na compra."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет покупок для восстановления. Проверьте, что вы вошли в Аккаунт Apple, с которого покупали."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inga köp att återställa. Kontrollera att du är inloggad med Apple-kontot du köpte med."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีการซื้อให้กู้คืน ตรวจสอบว่าลงชื่อเข้าด้วยบัญชี Apple ที่ใช้ซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri yüklenecek satın alım yok. Satın aldığın Apple Hesabı ile giriş yaptığından emin ol."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không có giao dịch để khôi phục. Hãy kiểm tra bạn đã đăng nhập bằng Tài khoản Apple dùng để mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有可恢复的购买。请确认已登录购买时使用的 Apple 账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有可恢復的購買。請確認已登入購買時使用的 Apple 帳號。"
          }
        }
      }
    },
    "두 번 탭하면 날짜, 끼니, 먹은 시각을 바꿀 수 있습니다" : {
      "comment" : "A hint that appears when tapping the target button to change the date, meal, and time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dvojitým klepnutím změníš datum, jídlo nebo čas jídla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
