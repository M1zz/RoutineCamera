    "마실 때마다 한 번 눌러 하루에 몇 잔 마셨는지 남겨요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap once for each drink to keep track of how many cups you have a day."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap once for each drink to keep track of how many cups you have a day."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po každém pití jednou klepni a uvidíš, kolik sklenic denně vypiješ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk én gang for hver drik, så kan du se, hvor mange du får om dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe bei jedem Getränk einmal und behalte im Blick, wie viel du am Tag trinkst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάτα μία φορά σε κάθε ποτό και δες πόσα ποτήρια πίνεις τη μέρα."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una vez cada vez que bebas y lleva la cuenta de cuántos vasos tomas al día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta kerran joka juomalla, niin näet, montako lasia juot päivässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une fois à chaque boisson pour suivre combien vous en buvez par jour."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk sekali setiap kali minum untuk mencatat berapa gelas sehari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una volta a ogni bevanda per sapere quanti bicchieri bevi al giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "飲むたびに1回タップして、1日に何杯飲んだかを記録できます。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk én gang for hver drikk, så ser du hvor mange glass du får i deg om dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik één keer per drankje en houd bij hoeveel je per dag drinkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij raz przy każdym napoju, aby wiedzieć, ile szklanek dziennie pijesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque uma vez a cada bebida para registrar quantos copos você toma por dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажимайте один раз за каждый напиток, чтобы знать, сколько выпиваете за день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck en gång för varje dryck och håll koll på hur många glas du dricker per dag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะหนึ่งครั้งทุกครั้งที่ดื่ม เพื่อบันทึกว่าวันนี้ดื่มไปกี่แก้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her içişinde bir kez dokun, günde kaç bardak içtiğini kaydet."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi lần uống chạm một lần để ghi lại mỗi ngày đã uống mấy cốc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每喝一次就点一下，记下一天喝了几杯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每喝一次就點一下，記下一天喝了幾杯。"
          }
        }
      }
    },
