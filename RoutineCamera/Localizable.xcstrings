    "설정 > 사진 저장에서 '찍은 곳 함께 남기기'를 켜면 다음 사진부터 지도에 모여요." : {
      "comment" : "Meal map empty state hint",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte „Ukládat místo jídla“ v Nastavení > Ukládání fotek a další fotky se objeví na mapě."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå “Gem hvor du spiste” til under Indstillinger > Gem fotos, så kommer dine næste billeder på kortet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Ort des Essens speichern“ unter Einstellungen > Fotos speichern – deine nächsten Fotos erscheinen dann auf der Karte."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποιήστε το «Αποθήκευση τοποθεσίας γεύματος» στις Ρυθμίσεις > Αποθήκευση φωτογραφιών και οι επόμενες φωτογραφίες θα εμφανιστούν στον χάρτη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on “Save Where You Ate” in Settings > Saving Photos, and your next photos will appear on the map."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on ‘Save Where You Ate’ in Settings > Saving Photos, and your next photos will appear on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Guardar dónde comiste» en Ajustes > Guardar fotos y tus próximas fotos aparecerán en el mapa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita päälle ”Tallenna ruokailupaikka” kohdassa Asetukset > Kuvien tallennus, niin seuraavat kuvasi näkyvät kartalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Enregistrer le lieu du repas » dans Réglages > Sauvegarde des photos : vos prochaines photos apparaîtront sur la carte."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan “Simpan lokasi makan” di Pengaturan > Menyimpan Foto, dan foto berikutnya akan muncul di peta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva “Salva dove hai mangiato” in Impostazioni > Salvataggio delle foto e le prossime foto appariranno sulla mappa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 > 写真の保存 で「撮影場所も記録」をオンにすると、次の写真から地図に集まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 > 사진 저장에서 '찍은 곳 함께 남기기'를 켜면 다음 사진부터 지도에 모여요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på «Lagre hvor du spiste» under Innstillinger > Lagring av bilder, så dukker de neste bildene opp på kartet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet ‘Opslaan waar je at’ aan in Instellingen > Foto’s bewaren, dan verschijnen je volgende foto’s op de kaart."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz „Zapisuj miejsce posiłku” w Ustawienia > Zapisywanie zdjęć, a kolejne zdjęcia pojawią się na mapie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative “Salvar onde você comeu” em Ajustes > Salvar fotos e suas próximas fotos aparecerão no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Сохранять место приёма пищи» в разделе Настройки > Сохранение фото — и следующие фото появятся на карте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på ”Spara var du åt” under Inställningar > Spara foton så visas dina nästa bilder på kartan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิด “บันทึกสถานที่ที่กิน” ใน การตั้งค่า > การบันทึกรูป แล้วรูปถัดไปจะมาอยู่บนแผนที่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayarlar > Fotoğrafları Kaydetme bölümünde “Yemek yediğin yeri kaydet” seçeneğini aç; sonraki fotoğrafların haritada görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật “Lưu nơi bạn ăn” trong Cài đặt > Lưu ảnh, ảnh tiếp theo sẽ hiện trên bản đồ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置 > 保存照片”中打开“记录拍摄地点”，之后拍的照片就会出现在地图上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定 > 儲存照片」中開啟「記錄拍攝地點」，之後拍的照片就會出現在地圖上。"
          }
        }
      }
    },
    "설정 ▸ 세끼 ▸ 알림을 켜야 친구 소식을 받을 수 있어요." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapni oznámení v Nastavení ▸ Sekki ▸ Oznámení, aby ti chodily novinky od přátel."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå notifikationer til i Indstillinger ▸ Sekki ▸ Notifikationer for at høre fra dine venner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Mitteilungen unter Einstellungen ▸ Sekki ▸ Mitteilungen, um Neuigkeiten von deinen Freunden zu erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ενεργοποίησε τις ειδοποιήσεις στις Ρυθμίσεις ▸ Sekki ▸ Ειδοποιήσεις για να ενημερώνεσαι για τους φίλους σου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on notifications in Settings ▸ Sekki ▸ Notifications to hear from your friends."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on notifications in Settings ▸ Sekki ▸ Notifications to hear from your friends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa las notificaciones en Ajustes ▸ Sekki ▸ Notificaciones para recibir novedades de tus amigos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota ilmoitukset käyttöön kohdassa Asetukset ▸ Sekki ▸ Ilmoitukset, niin saat kavereiden uutiset."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les notifications dans Réglages ▸ Sekki ▸ Notifications pour recevoir des nouvelles de vos amis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan notifikasi di Pengaturan ▸ Sekki ▸ Notifikasi untuk menerima kabar dari temanmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva le notifiche in Impostazioni ▸ Sekki ▸ Notifiche per ricevere novità dai tuoi amici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 ▸ Sekki ▸ 通知 でオンにすると、フレンドからのお知らせを受け取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 ▸ 세끼 ▸ 알림을 켜야 친구 소식을 받을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på varsler i Innstillinger ▸ Sekki ▸ Varsler for å få nyheter fra vennene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel meldingen in via Instellingen ▸ Sekki ▸ Meldingen om nieuws van je vrienden te ontvangen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz powiadomienia w Ustawienia ▸ Sekki ▸ Powiadomienia, aby dostawać wieści od znajomych."
          }
        },
        "pt-BR" : {
