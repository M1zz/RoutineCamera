    "촬영하면 사진앱 '%@' 앨범에 저장됩니다." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové fotky se ukládají do alba „%@“ ve Fotkách."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye fotos gemmes i albummet “%@” i Fotos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Fotos werden im Album „%@“ in Fotos gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι νέες φωτογραφίες αποθηκεύονται στο άλμπουμ «%@» των Φωτογραφιών."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New photos are saved to the “%@” album in Photos."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New photos are saved to the “%@” album in Photos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos nuevas se guardan en el álbum “%@” de Fotos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uudet kuvat tallennetaan Kuvat-apin albumiin ”%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouvelles photos sont enregistrées dans l’album « %@ » de Photos."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto baru disimpan ke album “%@” di Foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nuove foto vengono salvate nell’album “%@” in Foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撮影した写真は、写真Appの「%@」アルバムに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "촬영하면 사진앱 '%@' 앨범에 저장됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye bilder lagres i albumet «%@» i Bilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe foto’s worden bewaard in het album “%@” in Foto’s."
          }
        },
