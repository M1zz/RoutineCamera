    "식단 기록과 사진을 파일로 저장하고 다시 불러올 수 있어요." : {
      "comment" : "Roadmap item detail: backup and export",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uložte jídelníček a fotky do souboru a později je obnovte."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gem din maddagbog og dine billeder i en fil, og hent dem tilbage senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere Tagebuch und Fotos als Datei und hole sie später zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αποθήκευσε το ημερολόγιο και τις φωτογραφίες σε αρχείο και επανάφερέ τα αργότερα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your meal log and photos to a file and bring them back later."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your meal log and photos to a file and bring them back later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda tu diario y tus fotos en un archivo y recupéralos cuando quieras."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
