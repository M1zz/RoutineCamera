    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki uses the camera so you can snap a photo of each meal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식단을 저장하기 위해서 카메라를 사용합니다."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When App Lock is on, Face ID keeps your meal log private."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 잠금을 켜면 Face ID로 내 식단 기록을 지킵니다."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki saves your meal photos to a Sekki album in your photo library."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찍은 식단 사진을 사진 보관함의 세끼 앨범에 저장합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki opens your photo library so you can add meal photos you already took."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식단을 불러오기 위해서 앨범을 사용합니다."
