    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki uses the camera so you can snap a photo of each meal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "식단을 저장하기 위해서 카메라를 사용합니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki uses the camera so you can snap a photo of each meal."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki memakai kamera agar kamu bisa memotret setiap makananmu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食事の写真を撮影するために、カメラを使用します。"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki ใช้กล้องเพื่อให้คุณถ่ายรูปมื้ออาหารแต่ละมื้อได้"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sekki usa a câmera para você fotografar cada refeição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki 需要使用相机，以便你为每一餐拍照。"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki usa la fotocamera per scattare una foto di ogni pasto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki gebruikt de camera zodat je van elke maaltijd een foto kunt maken."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki 需要使用相機，讓你為每一餐拍照記錄。"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki bruker kameraet slik at du kan ta bilde av hvert måltid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki używa aparatu, abyś mógł zrobić zdjęcie każdego posiłku."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki använder kameran så att du kan fotografera dina måltider."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki использует камеру, чтобы вы могли фотографировать каждый приём пищи."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki bruger kameraet, så du kan tage et foto af hvert måltid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki usa la cámara para que puedas sacar una foto de cada comida."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Sekki χρησιμοποιεί την κάμερα για να τραβάς φωτογραφία κάθε γεύματός σου."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki nutzt die Kamera, damit du von jeder Mahlzeit ein Foto machen kannst."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki dùng camera để bạn chụp ảnh từng bữa ăn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki utilise l’appareil photo pour que vous puissiez prendre vos repas en photo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki käyttää kameraa, jotta voit ottaa kuvan jokaisesta ateriasta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki používá fotoaparát k focení tvých jídel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekki, her öğünün fotoğrafını çekebilmen için kamerayı kullanır."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When App Lock is on, Face ID keeps your meal log private."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 잠금을 켜면 Face ID로 내 식단 기록을 지킵니다."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
