// 세끼 — 버전·빌드번호의 단일 소스
//
// 이 파일이 앱(RoutineCamera)과 위젯(SekkiWidget) 두 타겟의 버전을 함께 정한다.
// 프로젝트 레벨 baseConfiguration 으로 연결돼 있어 두 타겟이 항상 같은 값을 쓴다.
// App Store 는 앱과 확장의 버전이 어긋나면 업로드를 거부하므로 반드시 한 곳에서만 고칠 것.
//
// ⚠️ Xcode 의 타겟 > General > Version·Build 칸을 고치면 project.pbxproj 에
//    MARKETING_VERSION 이 되살아나고 그쪽이 이 파일을 이겨 버린다.
//    (scripts/predeploy.sh 가 그 상황을 검사해서 배포를 막는다)
//    버전은 이 파일에서만, 또는 DeployBar 로 올린다.

// 스토어에 표시되는 버전 (예: 1.0.8)
MARKETING_VERSION = 1.0.8

// 빌드 번호 — 같은 MARKETING_VERSION 안에서 업로드할 때마다 올린다
CURRENT_PROJECT_VERSION = 1
